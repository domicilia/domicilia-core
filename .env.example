# Variables de domicilia-core. Copia a .env (en el devstack: `make env` lo genera
# a partir de domicilia-agent/.env, sin que tengas que copiar secretos a mano).
#
# Se llaman CORE_* a propósito: el .env de cada entorno lo comparten varios
# servicios y ya trae DATABASE_URL (la de GoTrue, con otro usuario) y PORT.

APP_ENV=development            # development | staging | production
LOG_LEVEL=debug                # debug | info | warn | error
CORE_HTTP_ADDR=:8080

# Base de datos. Host `domicilia-db` dentro de Docker, `localhost` fuera.
CORE_DATABASE_URL=postgres://USUARIO:CLAVE@domicilia-db:5432/domidb
CORE_DB_MAX_CONNS=10

# Mismo secreto HS256 con el que auth-domicilia firma los JWT (mínimo 32
# caracteres). Es el SECRET_KEY de domicilia-agent / GOTRUE_JWT_SECRET de GoTrue.
GOTRUE_JWT_SECRET=
GOTRUE_JWT_AUD=authenticated

# Dirección INTERNA de auth-domicilia (su admin API): con ella se crean las
# cuentas de quien entra por invitación (staff) o aprobación (domiciliarios).
# Dentro de Docker el host es `auth`. En desarrollo, si falta, usa
# http://localhost:9999; en staging/producción es obligatoria.
CORE_AUTH_URL=http://auth:9999

# Orígenes permitidos, separados por coma. "*" solo vale en desarrollo.
CORS_ORIGINS=http://localhost:3000

# Correo saliente del core (invitaciones, avisos) por SMTP con STARTTLS: el mismo servidor
# que usa auth-domicilia (Azure Communication Services, smtp.azurecomm.net:587). Sin
# CORE_SMTP_HOST no se envía nada: solo se registra que había un correo pendiente. Con host,
# usuario, contraseña y remitente son obligatorios. En desarrollo suele quedar sin configurar.
# CORE_SMTP_HOST=
# CORE_SMTP_PORT=587
# CORE_SMTP_USER=
# CORE_SMTP_PASS=
# CORE_SMTP_FROM=
# CORE_SMTP_FROM_NAME=Domicilia

# WhatsApp. Sin CORE_SECRETS_KEY no se puede conectar ningún número (503): el token de Meta se guarda CIFRADO con esta
# llave y nunca en claro. 32 bytes en base64: `openssl rand -base64 32`. Perderla deja ilegibles los tokens ya guardados.
# CORE_SECRETS_KEY=
# Secretos de la app de Meta de la plataforma: firman los webhooks y responden el desafío de suscripción.
# CORE_WHATSAPP_APP_SECRET=
# CORE_WHATSAPP_VERIFY_TOKEN=
# Graph API (por omisión la pública). En pruebas locales puede apuntar a un servidor simulado.
# CORE_WHATSAPP_API_BASE=https://graph.facebook.com
# CORE_WHATSAPP_API_VERSION=v23.0

# URL pública del frontend, para armar el enlace de las invitaciones
# ({CORE_APP_URL}/auth/accept-invite?token=...). Si falta, usa el primer origen de
# CORS_ORIGINS; en staging/producción, sin ninguno de los dos el servicio no arranca.
# CORE_APP_URL=http://localhost:3000

CORE_REQUEST_TIMEOUT=15s
CORE_SHUTDOWN_TIMEOUT=15s
CORE_MAX_BODY_BYTES=1048576
